# Game data ripped from the disc — copyrighted, and large.
/extract/

# The emulator, its unpacked AppImage, and a symlink to the disc image.
/emu/squashfs-root/
/emu/*.AppImage
/emu/*.zip
/emu/*.img
/emu/*.cue
/emu/*.log
/emu/*.pid
/emu/*.html
/emu/*.js

# Everything derived: RAM snapshots, decoded images, rendered maps, caches.
# All of it regenerates from the disc with the tools in tools/.
/out/

# What a tool writes beside the port's scripts is read off the disc as well --
# quest.py --godot puts the quest hooks here. The build makes its own copies in
# out/godot/, so nothing reads these, and they must not be published.
/godot/*.json

__pycache__/
*.pyc

# LibreOffice scratch
.~lock.*#

# PCSX-Redux runtime state that it regenerates on its own.
/emu/*.mcd
/emu/*.frag
/emu/*.vert
/emu/offscreen.lua
/emu/output.lua
/emu/pcsx.json
/emu/*.err
